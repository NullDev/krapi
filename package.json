{
    "name": "krapi",
    "version": "0.1.0",
    "description": "Typed client for the Krunker.io APIs",
    "keywords": ["krunker", "krunkerio", "krunker-api", "api-client", "typescript"],
    "homepage": "https://github.com/NullDev/krapi#readme",
    "bugs": {
        "url": "https://github.com/NullDev/krapi/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NullDev/krapi.git"
    },
    "license": "MIT",
    "author": "NullDev",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "bun": "./src/index.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": ["dist", "src", "README.md", "LICENSE"],
    "engines": {
        "node": ">=20.0.0",
        "bun": ">=1.0.0"
    },
    "packageManager": "bun@1.4.2",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "clean": "rm -rf dist",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "bun test",
        "live": "bun scripts/live.ts",
        "prepublishOnly": "bun run lint && bun run typecheck && bun run test && bun run clean && bun run build"
    },
    "devDependencies": {
        "@types/bun": "^1.3.0",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "eslint": "^10.10.0",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.14.0",
        "typescript": "^5.9.0"
    }
}
